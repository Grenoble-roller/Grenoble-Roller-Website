<% content_for :description, "Découvrez la communauté Roller Grenobloise ! Participez à des événements, partagez vos sorties et connectez-vous avec d'autres riders à Grenoble. Randonnées urbaines, cours d'initiation, événements à thème." %>

<!-- Hero (pitch + CTA) -->
<%= render 'pages/hero' %>

<!-- Ligne de séparation blanche (pleine largeur) -->
<div style="height: 2px; background: #ffffff; width: 100%;"></div>

<!-- Bannière annonces -->
<%= render 'pages/announcement_banner' %>

<!-- Ligne de séparation blanche (pleine largeur) -->
<div style="height: 2px; background: #ffffff; width: 100%;"></div>

<section class="container pb-5 pt-4">
  <% if @highlighted_events.any? %>
    <div class="mb-5">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
          <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between mb-4">
            <div class="d-flex align-items-center gap-2 mb-2 mb-md-0">
              <i class="bi bi-star-fill text-warning fs-5"></i>
              <h2 class="h3 fw-bold mb-0">Prochains rendez-vous</h2>
            </div>
            <%= link_to events_path, class: "btn btn-outline-primary btn-sm" do %>
              <i class="bi bi-calendar-event me-1"></i>
              Voir tous les événements
            <% end %>
          </div>

          <div class="row g-4">
            <% @highlighted_events.each_with_index do |event, index| %>
              <%= render 'events/event_card',
                         event: event,
                         render_signup_button: true,
                         current_user: current_user,
                         is_first: (index == 0),
                         column_class: 'col-12 col-md-6' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center py-5 mb-5">
      <div class="card card-liquid rounded-liquid shadow-liquid p-5">
        <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
        <h3 class="h4 fw-bold mt-3 mb-2">Aucun événement à venir</h3>
        <p class="text-body-secondary mb-4">
          Les prochains événements apparaîtront ici dès qu'ils seront programmés.
        </p>
        <%= link_to events_path, class: "btn btn-liquid-primary" do %>
          <i class="bi bi-calendar-event me-2"></i>
          Voir tous les événements
        <% end %>
      </div>
    </div>
  <% end %>
</section>

<!-- Ligne de séparation blanche (pleine largeur) -->
<div style="height: 2px; background: #ffffff; width: 100%;"></div>

<!-- Section À propos -->
<section class="py-5 section-alt">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center">
        <h2 class="h3 fw-bold mb-3">À propos de Grenoble Roller</h2>
        
        <!-- Ligne de séparation blanche -->
        <div style="height: 2px; background: #ffffff; width: 100%; max-width: 200px; margin: 0 auto 1.5rem;"></div>
        
        <p class="lead text-body-secondary mb-4">
          Association à but non lucratif, nous organisons des randonnées urbaines 
          encadrées ainsi que des cours de roller pour favoriser le lien social dans un 
          esprit convivial et sportif.
          Rejoignez une communauté passionnée depuis plus de 20 ans !
        </p>
        <%= link_to about_path, class: "btn btn-liquid-primary" do %>
          <i class="bi bi-arrow-right-circle me-2" aria-hidden="true"></i>
          En savoir plus sur l'association
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Ligne de séparation blanche (pleine largeur) -->
<div style="height: 2px; background: #ffffff; width: 100%;"></div>

<!-- Pourquoi nous rejoindre ? (version minimaliste) -->
<section class="py-4 mb-4">
  <div class="container">
    <h2 class="h3 fw-bold text-center mb-4">Pourquoi nous rejoindre ?</h2>

    <div class="row g-3">
      <div class="col-md-4">
        <div class="card card-liquid rounded-liquid shadow-sm h-100 border-0">
          <div class="card-body text-center py-4">
            <i class="bi bi-people fs-1 text-liquid-primary mb-3" aria-hidden="true"></i>
            <h3 class="h6 fw-bold mb-2">Tous niveaux</h3>
            <p class="small text-body-secondary mb-0">
              Débutants et experts trouvent leur place
            </p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card card-liquid rounded-liquid shadow-sm h-100 border-0">
          <div class="card-body text-center py-4">
            <i class="bi bi-shield-check fs-1 text-liquid-success mb-3" aria-hidden="true"></i>
            <h3 class="h6 fw-bold mb-2">Sécurité</h3>
            <p class="small text-body-secondary mb-0">
              Parcours et initiations encadrés par des staffeurs formés
            </p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card card-liquid rounded-liquid shadow-sm h-100 border-0">
          <div class="card-body text-center py-4">
            <i class="bi bi-calendar-heart fs-1 text-liquid-danger mb-3" aria-hidden="true"></i>
            <h3 class="h6 fw-bold mb-2">20+ ans</h3>
            <p class="small text-body-secondary mb-0">
              Association active depuis 2005
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center mt-4">
      <%= link_to about_path, class: "btn btn-outline-liquid-primary" do %>
        <i class="bi bi-arrow-right-circle me-2" aria-hidden="true"></i>
        En savoir plus
      <% end %>
    </div>
  </div>
</section>

<!-- FAQ section -->
<section class="py-5">
  <div class="container">
    <h2 class="h3 fw-bold text-center mb-4">Questions Fréquemment Posées</h2>
    <div class="accordion accordion-flush" id="faqHomepageAccordion" role="tablist" aria-label="Questions fréquemment posées">
      <!-- Question 1 -->
      <div class="accordion-item card card-liquid border-liquid mb-2">
        <h3 class="accordion-header" id="faqHomepage1">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqHomepageCollapse1" aria-expanded="false" aria-controls="#faqHomepageCollapse1">
            <strong>Comment adhérer à l'association Grenoble Roller ?</strong>
          </button>
        </h3>
        <div id="faqHomepageCollapse1" class="accordion-collapse collapse" aria-labelledby="faqHomepage1" data-bs-parent="#faqHomepageAccordion">
          <div class="accordion-body">
            <p>Pour adhérer à l'association Grenoble Roller :</p>
            <ol>
              <li>Créez un compte sur le site en cliquant sur "S'inscrire"</li>
              <li>Remplissez le formulaire d'adhésion avec vos informations</li>
              <li>Choisissez votre formule (adulte ou enfant)</li>
              <li>Effectuez le paiement en ligne via HelloAsso</li>
            </ol>
            <p class="mb-0">
              <%= link_to "Adhérer maintenant", new_membership_path(type: 'adult'), class: "btn btn-liquid-primary btn-sm mt-2" %>
            </p>
          </div>
        </div>
      </div>
      <!-- Question 2 -->
      <div class="accordion-item card card-liquid border-liquid mb-2">
        <h3 class="accordion-header" id="faqHomepage2">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqHomepageCollapse2" aria-expanded="false" aria-controls="#faqHomepageCollapse2">
            <strong>Quels sont les tarifs d'adhésion ?</strong>
          </button>
        </h3>
        <div id="faqHomepageCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHomepage2" data-bs-parent="#faqHomepageAccordion">
          <div class="accordion-body">
            <p>Les tarifs d'adhésion pour la saison en cours sont :</p>
            <ul>
              <li>Adulte : 40€</li>
              <li>Enfant (moins de 18 ans) : 20€</li>
              <li>Tarif réduit (étudiant, demandeur d'emploi) : 30€ (sur justificatif)</li>
            </ul>
            <p>Les adhésions sont valables du 1er septembre au 31 août de l'année suivante.</p>
            <p class="mb-0">
              <%= link_to "Voir les détails", memberships_path, class: "btn btn-outline-primary btn-sm mt-2" %>
            </p>
          </div>
        </div>
      </div>
      <!-- Question 3 -->
      <div class="accordion-item card card-liquid border-liquid mb-2">
        <h3 class="accordion-header" id="faqHomepage3">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqHomepageCollapse3" aria-expanded="false" aria-controls="#faqHomepageCollapse3">
            <strong>Puis-je essayer le roller avant de m'inscrire ?</strong>
          </button>
        </h3>
        <div id="faqHomepageCollapse3" class="accordion-collapse collapse" aria-labelledby="faqHomepage3" data-bs-parent="#faqHomepageAccordion">
          <div class="accordion-body">
            <p>Oui, nous proposons des séances d'initiation gratuites tout au long de l'année.</p>
            <p>Ces séances sont encadrées par nos staffeurs et permettent de découvrir le roller en toute sécurité.</p>
            <p>Pour participer, il suffit de vous rendre à l'une de nos sorties publiques indiquée sur le calendrier et de demander à essayer.</p>
            <p class="mb-0">
              <%= link_to "Voir les prochaines séances", initiations_path, class: "btn btn-outline-primary btn-sm mt-2" %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Chiffres clés (version simplifiée) -->
<section class="py-4 mb-4 section-alt">
  <div class="container">
    <div class="row g-3 text-center">
      <div class="col-6 col-md-3">
        <div class="p-3">
          <div class="display-5 fw-bold text-liquid-primary"><%= @users_count %></div>
          <p class="small text-body-secondary mb-0">Membres actifs</p>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="p-3">
          <div class="display-5 fw-bold text-liquid-success"><%= @events_count %></div>
          <p class="small text-body-secondary mb-0">Événements organisés</p>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="p-3">
          <div class="display-5 fw-bold text-liquid-warning"><%= @upcoming_events_count %></div>
          <p class="small text-body-secondary mb-0">À venir</p>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="p-3">
          <div class="display-5 fw-bold text-liquid-info"><%= @attendances_count %></div>
          <p class="small text-body-secondary mb-0">Inscriptions</p>
        </div>
      </div>
    </div>
  </div>
</section>