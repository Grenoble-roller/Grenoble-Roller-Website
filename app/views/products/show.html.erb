<% content_for :title, "#{@product.name} - Boutique Grenoble Roller" %>
<% content_for :description, "#{@product.name} - #{@product.description.presence || 'Produit disponible dans la boutique Grenoble Roller'}. Commandez en ligne !" %>

<%
  if @variants.any?
    variant_min = @variants.where.not(price_cents: nil).minimum(:price_cents)
    variant_max = @variants.where.not(price_cents: nil).maximum(:price_cents)
    single_variant = @variants.count == 1 ? @variants.first : nil
  else
    variant_min = nil
    variant_max = nil
    single_variant = nil
  end
  min_price = variant_min || @product.price_cents
  max_price = variant_max || @product.price_cents
  has_multiple_prices = min_price.present? && max_price.present? && min_price != max_price
  total_stock = product_available_stock(@variants)
  stock_level = stock_availability_level(total_stock)
  gallery = product_gallery_entries(@product, @variants)
  main_image = product_lazy_image_tag(@product)
  main_image_url = product_image_url(@product)
%>

<div class="container py-4 py-lg-5 product-pdp-page">
  <nav class="product-show-nav mb-3" aria-label="Fil d'Ariane produit">
    <%= link_to shop_path, class: "product-show-back" do %>
      <i class="bi bi-arrow-left" aria-hidden="true"></i>
      <span>Boutique</span>
    <% end %>
    <span class="product-show-nav-sep" aria-hidden="true">/</span>
    <span class="product-show-nav-current text-truncate"><%= @product.name %></span>
  </nav>

  <!-- Temporary HelloAsso banner — keep until volunteers finish native shop -->
  <div class="alert alert-info d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4" role="alert">
    <div class="d-flex align-items-center">
      <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
      <span>Boutique temporairement en cours de migration. En attendant, accédez à notre <strong>ancienne boutique HelloAsso</strong>.</span>
    </div>
    <%= link_to "https://www.helloasso.com/associations/grenoble-roller/boutiques/boutique",
        target: "_blank",
        rel: "noopener noreferrer",
        class: "btn btn-sm btn-outline-primary flex-shrink-0" do %>
      <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>
      Accéder à la boutique HelloAsso
    <% end %>
  </div>

  <div class="product-pdp"
       data-controller="product-show"
       data-product-show-variants-value='<%= @variants.map { |v|
         begin
           option_vals = v.option_values.to_a
           size_opt = option_vals.find { |ov| ov.option_type&.name == "size" }
           color_opt = option_vals.find { |ov| ov.option_type&.name == "color" }
           {
             id: v.id,
             sizeId: size_opt&.id,
             colorId: color_opt&.id,
             stock: variant_available_stock(v),
             price: v.price_cents,
             imageUrl: variant_image_url(v) || ""
           }
         rescue => e
           Rails.logger.error "[ProductShow] variant options #{v.id}: #{e.message}"
           {
             id: v.id,
             sizeId: nil,
             colorId: nil,
             stock: variant_available_stock(v),
             price: v.price_cents,
             imageUrl: variant_image_url(v) || ""
           }
         end
       }.to_json.html_safe %>'
       data-product-show-default-image-url-value="<%= (main_image_url || "").to_json.html_safe %>">

    <div class="row g-4 g-xl-5 align-items-start">
      <!-- Gallery (hero media + thumbs) -->
      <div class="col-12 col-md-6">
        <div class="product-gallery">
          <div class="product-show-image-wrapper">
            <div class="card-product-image product-show-media"
                 <% if main_image %>
                   role="button"
                   tabindex="0"
                   data-bs-toggle="modal"
                   data-bs-target="#productImageModalShow"
                   aria-label="Agrandir l'image de <%= @product.name %>"
                 <% end %>>
              <% if main_image %>
                <%= lazy_image_tag main_image,
                      alt: @product.name,
                      class: "product-show-photo",
                      loading: "eager",
                      decoding: "async",
                      data: { product_show_target: "productImage" } %>
              <% else %>
                <div class="product-show-placeholder d-flex align-items-center justify-content-center w-100 h-100" aria-hidden="true">
                  <i class="bi bi-image fs-1 text-muted"></i>
                </div>
              <% end %>
            </div>
            <%= render "products/stock_badge",
                       level: stock_level,
                       qty: total_stock,
                       product_qty: total_stock,
                       live: true %>
          </div>

          <% if gallery.size > 1 %>
            <div class="product-gallery-thumbs" role="list" aria-label="Autres photos du produit">
              <% gallery.each_with_index do |entry, idx| %>
                <button type="button"
                        class="product-gallery-thumb<%= " is-active" if idx.zero? %>"
                        role="listitem"
                        data-product-show-target="galleryThumb"
                        data-image-url="<%= entry[:full_url] %>"
                        data-action="click->product-show#pickGalleryImage"
                        aria-label="<%= entry[:label].presence || "Photo #{idx + 1}" %>"
                        aria-pressed="<%= idx.zero? %>">
                  <%= lazy_image_tag entry[:thumb_url], alt: "", loading: "lazy", decoding: "async" %>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Buy column (purchase path only — pro PDP pattern) -->
      <div class="col-12 col-md-6">
        <div class="product-buy">
          <% if @product.category %>
            <p class="product-buy-category mb-1">
              <i class="bi bi-tag me-1" aria-hidden="true"></i><%= @product.category.name %>
            </p>
          <% end %>
          <h1 class="product-show-title"><%= @product.name %></h1>

          <p class="product-buy-price" aria-live="polite">
            <% if has_multiple_prices %>
              <span class="product-show-price-prefix">À partir de</span>
            <% end %>
            <strong class="product-show-price-value" data-product-show-target="unitPriceValue"><%= format_price(min_price) %></strong>
          </p>

          <% if @variants.any? %>
            <%
              all_option_values = @variants.flat_map { |v| v.option_values.to_a }.uniq
              size_options = all_option_values.select { |ov| ov.option_type&.name == "size" }.uniq
              color_options = all_option_values.select { |ov| ov.option_type&.name == "color" }.uniq
              size_stock = Hash.new(0)
              color_stock = Hash.new(0)
              @variants.each do |v|
                available = variant_available_stock(v)
                next if available <= 0
                v.option_values.to_a.each do |ov|
                  next unless ov.option_type
                  case ov.option_type.name
                  when "size" then size_stock[ov.id] = [size_stock[ov.id], available].max
                  when "color" then color_stock[ov.id] = [color_stock[ov.id], available].max
                  end
                end
              end
            %>
            <div class="product-options">
              <% if size_options.size > 1 %>
                <div class="product-option-group">
                  <span class="product-option-label">Taille</span>
                  <select class="visually-hidden" aria-hidden="true" tabindex="-1" id="size-select-detail"
                          data-product-show-target="sizeSelect" data-action="change->product-show#sizeChanged">
                    <option value="">Choisir taille</option>
                    <% size_options.each do |size_opt| %>
                      <option value="<%= size_opt.id %>" <%= "disabled" if size_stock[size_opt.id] <= 0 %>>
                        <%= size_opt.presentation %><%= " (épuisé)" if size_stock[size_opt.id] <= 0 %>
                      </option>
                    <% end %>
                  </select>
                  <div class="product-option-tiles" role="group" aria-label="Choisir la taille">
                    <% size_options.each do |size_opt| %>
                      <button type="button" class="product-option-tile"
                              data-product-show-tile="size" data-size-id="<%= size_opt.id %>"
                              data-action="click->product-show#pickSize" aria-pressed="false"
                              <%= "disabled" if size_stock[size_opt.id] <= 0 %>>
                        <%= size_opt.presentation.to_s.sub(/\ATaille\s+/i, "") %>
                      </button>
                    <% end %>
                  </div>
                </div>
              <% elsif size_options.size == 1 %>
                <p class="product-option-static mb-0">
                  <span class="product-option-label">Taille</span>
                  <%= size_options.first.presentation %>
                </p>
              <% end %>

              <% if color_options.size > 1 %>
                <div class="product-option-group">
                  <span class="product-option-label">Couleur</span>
                  <select class="visually-hidden" aria-hidden="true" tabindex="-1" id="color-select-detail"
                          data-product-show-target="colorSelect" data-action="change->product-show#colorChanged">
                    <option value="">Choisir couleur</option>
                    <% color_options.each do |color_opt| %>
                      <option value="<%= color_opt.id %>" <%= "disabled" if color_stock[color_opt.id] <= 0 %>>
                        <%= color_opt.presentation %><%= " (épuisé)" if color_stock[color_opt.id] <= 0 %>
                      </option>
                    <% end %>
                  </select>
                  <div class="product-option-tiles" role="group" aria-label="Choisir la couleur">
                    <% color_options.each do |color_opt| %>
                      <button type="button" class="product-option-tile"
                              data-product-show-tile="color" data-color-id="<%= color_opt.id %>"
                              data-action="click->product-show#pickColor" aria-pressed="false"
                              <%= "disabled" if color_stock[color_opt.id] <= 0 %>>
                        <%= color_opt.presentation %>
                      </button>
                    <% end %>
                  </div>
                </div>
              <% elsif color_options.size == 1 %>
                <p class="product-option-static mb-0">
                  <span class="product-option-label">Couleur</span>
                  <%= color_options.first.presentation %>
                </p>
              <% end %>

              <% if size_options.empty? && color_options.empty? %>
                <p class="product-option-static mb-0">
                  <span class="product-option-label">Taille</span>
                  Unique
                </p>
              <% end %>
            </div>

            <p id="stock_hint" class="product-stock-hint" style="display: none;" data-product-show-target="stockHint">
              Stock disponible : <span id="stock_value" data-product-show-target="stockValue">0</span>
            </p>
          <% end %>

          <%= form_with url: add_item_cart_path, method: :post, class: "product-buy-form", id: "add-to-cart-form", data: { turbo: false } do |f| %>
            <%= hidden_field_tag :variant_id, single_variant ? single_variant.id : "", id: "variant-id-detail", required: true, data: { product_show_target: "variantInput" } %>

            <div class="product-buy-row">
              <div class="product-qty-block">
                <label for="quantity_field" class="product-option-label mb-1">Quantité</label>
                <div class="qty-control product-qty-control">
                  <%= button_tag type: "button", class: "qty-btn", aria: { label: "Diminuer" }, data: { action: "click->product-show#decrementQty" } do %>
                    <i class="bi bi-dash" aria-hidden="true"></i>
                  <% end %>
                  <%= number_field_tag :quantity, 1,
                        min: 1,
                        max: (single_variant ? variant_available_stock(single_variant) : nil),
                        class: "form-control border-0 bg-transparent p-0 form-control-number-compact",
                        id: "quantity_field",
                        data: { product_show_target: "qtyField", action: "input->product-show#quantityChanged" } %>
                  <%= button_tag type: "button", class: "qty-btn", aria: { label: "Augmenter" }, data: { action: "click->product-show#incrementQty" } do %>
                    <i class="bi bi-plus" aria-hidden="true"></i>
                  <% end %>
                </div>
              </div>
              <div class="product-total" aria-live="polite">
                <span class="product-total-label">Total</span>
                <span id="price_detail" class="product-total-value" data-product-show-target="priceDisplay"><%= format_price(min_price) %></span>
              </div>
            </div>

            <button type="submit"
                    class="btn btn-liquid-primary product-add-btn"
                    id="add-btn-detail"
                    data-product-show-target="addButton"
                    <%= "disabled" unless single_variant && variant_available_stock(single_variant) > 0 %>>
              <i class="bi bi-cart-plus me-2" aria-hidden="true"></i>
              Ajouter au panier
            </button>

            <%= link_to cart_path, class: "product-cart-link" do %>
              <i class="bi bi-basket me-1" aria-hidden="true"></i>
              Voir le panier
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <% if @product.description.present? %>
      <section class="product-details" aria-labelledby="product-details-heading">
        <h2 id="product-details-heading" class="product-details-title">Description</h2>
        <div class="product-details-body">
          <%= simple_format(@product.description) %>
        </div>
      </section>
    <% end %>
  </div>
</div>

<% if main_image %>
  <div class="modal fade" id="productImageModalShow" tabindex="-1" aria-labelledby="productImageModalLabelShow" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content bg-transparent border-0">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title text-white" id="productImageModalLabelShow"><%= @product.name %></h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body p-0 text-center">
          <%= lazy_image_tag main_image, alt: @product.name, class: "img-fluid rounded", style: "max-height: 80vh; width: auto;", id: "productModalImage" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
