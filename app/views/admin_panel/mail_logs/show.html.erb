<div class="admin-mail-logs">
  <div class="admin-page-header">
    <div>
      <h1>📧 Détails de l'Email</h1>
      <p class="text-muted">Log #<%= @log.id %><% if @log.active_job_id.present? %> · Job <%= @log.active_job_id %><% end %></p>
    </div>
    <div>
      <%= link_to admin_panel_mail_logs_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Retour à la liste
      <% end %>
    </div>
  </div>

  <div class="card card-liquid rounded-liquid shadow-liquid mb-4">
    <div class="card-header">
      <h2 class="h5 mb-0">Informations Générales</h2>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <dl class="row">
            <dt class="col-sm-4">ID Log:</dt>
            <dd class="col-sm-8"><code><%= @log.id %></code></dd>

            <dt class="col-sm-4">Mailer:</dt>
            <dd class="col-sm-8">
              <% if @mailer_info[:mailer] %>
                <code><%= @mailer_info[:mailer] %></code>
              <% else %>
                <span class="text-muted">N/A</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Méthode:</dt>
            <dd class="col-sm-8">
              <% if @mailer_info[:method] %>
                <span class="badge badge-liquid-secondary"><%= @mailer_info[:method] %></span>
              <% else %>
                <span class="text-muted">N/A</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Solid Queue:</dt>
            <dd class="col-sm-8">
              <% if @log.solid_queue_job_id %>
                <code><%= @log.solid_queue_job_id %></code>
              <% else %>
                <span class="text-muted">N/A</span>
              <% end %>
            </dd>
          </dl>
        </div>
        <div class="col-md-6">
          <dl class="row">
            <dt class="col-sm-4">Statut:</dt>
            <dd class="col-sm-8">
              <% if @log.status == "failed" %>
                <span class="badge badge-liquid-danger">Échec</span>
              <% elsif @log.pending? %>
                <span class="badge badge-liquid-warning">En attente</span>
              <% else %>
                <span class="badge badge-liquid-success">Terminé</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">En file le:</dt>
            <dd class="col-sm-8"><%= l(@log.queued_at, format: :long) %></dd>

            <dt class="col-sm-4">Terminé le:</dt>
            <dd class="col-sm-8">
              <% if @log.finished_at %>
                <%= l(@log.finished_at, format: :long) %>
              <% else %>
                <span class="text-muted">En cours...</span>
              <% end %>
            </dd>
          </dl>
        </div>
      </div>

      <% if @log.pending? && @log.queued_at < 5.minutes.ago %>
        <div class="alert alert-warning mt-3 mb-0">
          <strong>⚠️ Email en attente</strong>
          <p class="mb-0 small">
            En attente depuis <%= time_ago_in_words(@log.queued_at) %>.
            Vérifiez que Solid Queue traite la queue des jobs mail.
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <% if @log.error_message.present? || @failed_execution %>
    <div class="card card-liquid rounded-liquid shadow-liquid mb-4 border-danger">
      <div class="card-header" style="background: var(--gradient-liquid-danger); color: white;">
        <h3 class="h5 mb-0">❌ Erreur</h3>
      </div>
      <div class="card-body">
        <pre class="p-3 rounded border"><%= @log.error_message.presence || @failed_execution&.error %></pre>
      </div>
    </div>
  <% end %>

  <div class="card card-liquid rounded-liquid shadow-liquid mb-4">
    <div class="card-header">
      <h4 class="h5 mb-0">Arguments</h4>
    </div>
    <div class="card-body">
      <pre class="p-3 rounded border"><%= JSON.pretty_generate(@log.arguments) %></pre>
    </div>
  </div>

  <div class="card card-liquid rounded-liquid shadow-liquid">
    <div class="card-body">
      <div class="d-flex gap-2">
        <%= link_to "/admin-panel/jobs", class: "btn btn-outline-primary" do %>
          <i class="bi bi-speedometer2 me-2"></i>Voir dans Mission Control
        <% end %>
        <%= link_to admin_panel_mail_logs_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-2"></i>Retour à la liste
        <% end %>
      </div>
    </div>
  </div>
</div>
