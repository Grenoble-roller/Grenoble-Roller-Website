<div class="admin-audit-logs">
  <!-- HEADER -->
  <div class="admin-page-header">
    <div>
      <h1>📋 Détail du Log d'Audit</h1>
      <p class="text-muted">Log #<%= @log.id %></p>
    </div>
    <div>
      <%= link_to admin_panel_audit_logs_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Retour à la liste
      <% end %>
    </div>
  </div>

  <!-- INFORMATIONS GÉNÉRALES -->
  <div class="card card-liquid rounded-liquid shadow-liquid mb-4">
    <div class="card-header">
      <h5 class="mb-0">Informations Générales</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <dl class="row">
            <dt class="col-sm-4">ID:</dt>
            <dd class="col-sm-8"><code><%= @log.id %></code></dd>

            <dt class="col-sm-4">Action:</dt>
            <dd class="col-sm-8">
              <span class="badge badge-liquid-secondary"><%= @log.action %></span>
            </dd>

            <dt class="col-sm-4">Cible:</dt>
            <dd class="col-sm-8"><code><%= @log.target_type %>#<%= @log.target_id %></code></dd>
          </dl>
        </div>
        <div class="col-md-6">
          <dl class="row">
            <dt class="col-sm-4">Acteur:</dt>
            <dd class="col-sm-8">
              <% if @log.actor_user %>
                <%= @log.actor_user.display_name.presence || @log.actor_user.email %>
                <span class="text-muted small d-block"><%= @log.actor_user.email %></span>
              <% else %>
                <span class="text-muted">Système</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Créé le:</dt>
            <dd class="col-sm-8"><%= l(@log.created_at, format: :long) %></dd>

            <dt class="col-sm-4">Modifié le:</dt>
            <dd class="col-sm-8"><%= l(@log.updated_at, format: :long) %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <!-- MÉTADONNÉES -->
  <div class="card card-liquid rounded-liquid shadow-liquid mb-4">
    <div class="card-header">
      <h5 class="mb-0">Métadonnées</h5>
    </div>
    <div class="card-body">
      <% if @log.metadata.present? %>
        <pre class="p-3 rounded border"><%= JSON.pretty_generate(@log.metadata) %></pre>
      <% else %>
        <p class="text-muted mb-0">Aucune métadonnée enregistrée.</p>
      <% end %>
    </div>
  </div>

  <!-- HISTORIQUE DE LA MÊME CIBLE -->
  <div class="card card-liquid rounded-liquid shadow-liquid mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Historique de cette cible</h5>
      <div class="text-muted small"><%= @history.size %> autre(s) entrée(s)</div>
    </div>
    <div class="card-body p-0">
      <% if @history.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Action</th>
                <th scope="col">Acteur</th>
                <th scope="col" class="text-end">Détail</th>
              </tr>
            </thead>
            <tbody>
              <% @history.each do |log| %>
                <tr>
                  <td class="text-nowrap"><%= l(log.created_at, format: :short) %></td>
                  <td><span class="badge badge-liquid-secondary"><%= log.action %></span></td>
                  <td>
                    <% if log.actor_user %>
                      <%= log.actor_user.display_name.presence || log.actor_user.email %>
                    <% else %>
                      <span class="text-muted">Système</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <%= link_to admin_panel_audit_log_path(log),
                        class: "btn btn-sm btn-outline-primary",
                        aria: { label: "Voir le détail du log ##{log.id}" } do %>
                      <i class="bi bi-eye" aria-hidden="true"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-4 text-center text-muted">
          Aucune autre entrée pour cette cible.
        </div>
      <% end %>
    </div>
  </div>

  <div class="card card-liquid rounded-liquid shadow-liquid">
    <div class="card-body">
      <div class="d-flex gap-2">
        <%= link_to admin_panel_audit_logs_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Retour à la liste
        <% end %>
      </div>
    </div>
  </div>
</div>
